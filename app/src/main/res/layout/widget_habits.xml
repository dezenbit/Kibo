<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/background_light"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#1C1B1F" />

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textSize="11sp"
        android:textColor="#625B71" />

    <LinearLayout
        android:id="@+id/widget_row_0"
        style="@style/WidgetHabitRow">
        <TextView android:id="@+id/widget_row_0_text" style="@style/WidgetHabitRowText" />
        <ImageView android:id="@+id/widget_row_0_check" style="@style/WidgetHabitRowCheck" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_1"
        style="@style/WidgetHabitRow">
        <TextView android:id="@+id/widget_row_1_text" style="@style/WidgetHabitRowText" />
        <ImageView android:id="@+id/widget_row_1_check" style="@style/WidgetHabitRowCheck" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        style="@style/WidgetHabitRow">
        <TextView android:id="@+id/widget_row_2_text" style="@style/WidgetHabitRowText" />
        <ImageView android:id="@+id/widget_row_2_check" style="@style/WidgetHabitRowCheck" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_3"
        style="@style/WidgetHabitRow">
        <TextView android:id="@+id/widget_row_3_text" style="@style/WidgetHabitRowText" />
        <ImageView android:id="@+id/widget_row_3_check" style="@style/WidgetHabitRowCheck" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_4"
        style="@style/WidgetHabitRow">
        <TextView android:id="@+id/widget_row_4_text" style="@style/WidgetHabitRowText" />
        <ImageView android:id="@+id/widget_row_4_check" style="@style/WidgetHabitRowCheck" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sin hábitos para hoy"
        android:textSize="12sp"
        android:textColor="#625B71"
        android:visibility="gone" />

</LinearLayout>
